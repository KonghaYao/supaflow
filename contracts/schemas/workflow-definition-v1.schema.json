{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supaflow.dev/schemas/workflow-definition-v1.schema.json",
  "title": "Supaflow WorkflowDefinition v1",
  "type": "object",
  "required": ["schemaVersion", "id", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": "v1" },
    "id": { "$ref": "#/$defs/id" },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "valueType": {
      "enum": ["any", "string", "number", "integer", "boolean", "object", "array"]
    },
    "binding": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/valueType" },
        "literal": true,
        "source": {
          "type": "object",
          "required": ["nodeId", "port"],
          "properties": {
            "nodeId": { "$ref": "#/$defs/id" },
            "port": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        { "required": ["literal"], "not": { "required": ["source"] } },
        { "required": ["source"], "not": { "required": ["literal"] } }
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "config": { "type": "object" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/binding" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "fromNode", "fromPort", "toNode", "toPort"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromNode": { "$ref": "#/$defs/id" },
        "fromPort": { "$ref": "#/$defs/id" },
        "toNode": { "$ref": "#/$defs/id" },
        "toPort": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    }
  }
}
